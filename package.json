{
  "name": "dnd-app",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "generate:build-info": "node scripts/generate-build-info.mjs",
    "prestart": "npm run generate:build-info",
    "start": "ng serve",
    "prebuild": "npm run generate:build-info",
    "build": "ng build",
    "prewatch": "npm run generate:build-info",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run generate:build-info",
    "test": "vitest",
    "pretest:ci": "npm run generate:build-info",
    "test:ci": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.spec.json --noEmit && tsc -p functions --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pages:deploy": "npm run build && wrangler pages deploy dist/dnd-app/browser --project-name=dnd-app",
    "pages:dev": "wrangler pages dev dist/dnd-app/browser",
    "sonar": "sonar-scanner",
    "lint": "ng lint",
    "srd:seed": "node scripts/srd/build-srd-seed.mjs",
    "srd:check": "node --no-warnings scripts/srd/check-srd-seed.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "wrangler": "^4.143.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.5",
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@cloudflare/workers-types": "^5.20260925.1",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.2",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.1.1",
    "prettier": "3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "^5.0.1"
  }
}
