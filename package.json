{
  "name": "dnd-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "pages:deploy": "npm run build && wrangler pages deploy dist/dnd-app/browser --project-name=dnd-app",
    "pages:dev": "wrangler pages dev dist/dnd-app/browser",
    "sonar": "sonar-scanner"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.2.24",
    "@angular/compiler": "^21.2.24",
    "@angular/core": "^21.2.24",
    "@angular/forms": "^21.2.24",
    "@angular/platform-browser": "^21.2.24",
    "@angular/platform-browser-dynamic": "^21.2.24",
    "@angular/router": "^21.2.24",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "wrangler": "^4.139.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.3.1",
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.24",
    "@cloudflare/workers-types": "^5.20260923.1",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.11"
  }
}
