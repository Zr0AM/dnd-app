// Standalone TypeScript config for the simulator package. It is pure TypeScript
// with no Angular dependency, and lives outside src/ so the app build never
// pulls it in. Strictness mirrors the root tsconfig.
{
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    // DOM is included only for the Web Crypto global (crypto.getRandomValues),
    // which Node provides at runtime. No DOM runtime is used. vitest helpers are
    // imported explicitly in specs, so no ambient test types are needed.
    "lib": ["ES2022", "DOM"],
    "types": [],
    "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
